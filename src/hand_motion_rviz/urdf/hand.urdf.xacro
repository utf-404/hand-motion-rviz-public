<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera_hands">
  <material name="shell_ivory"><color rgba="0.82 0.86 0.88 1"/></material>
  <material name="joint_graphite"><color rgba="0.10 0.13 0.16 1"/></material>
  <material name="grip_rubber"><color rgba="0.20 0.26 0.29 1"/></material>
  <material name="accent_teal"><color rgba="0.10 0.61 0.59 1"/></material>
  <material name="hinge_steel"><color rgba="0.46 0.53 0.57 1"/></material>

  <!-- A common root lets robot_state_publisher expose both hands as one model. -->
  <link name="hands_base"/>

  <xacro:macro name="segment" params="prefix name length radius">
    <link name="${prefix}_${name}">
      <visual name="${prefix}_${name}_bone">
        <geometry><mesh filename="package://hand_motion_rviz/meshes/${'fingertip.stl' if name.endswith('_distal') else 'phalanx.stl'}" scale="${length} ${radius} ${radius * 0.91}"/></geometry>
        <material name="shell_ivory"/>
      </visual>
      <visual name="${prefix}_${name}_joint">
        <origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${radius * 0.76}" length="${radius * 1.86}"/></geometry>
        <material name="joint_graphite"/>
      </visual>
      <visual name="${prefix}_${name}_hinge_outer">
        <origin xyz="0 ${radius * 0.99} 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${radius * 0.38}" length="0.0015"/></geometry>
        <material name="hinge_steel"/>
      </visual>
      <visual name="${prefix}_${name}_hinge_inner">
        <origin xyz="0 ${radius * -0.99} 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${radius * 0.38}" length="0.0015"/></geometry>
        <material name="hinge_steel"/>
      </visual>
      <visual name="${prefix}_${name}_grip">
        <origin xyz="${length * 0.53} 0 ${radius * -0.82}"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="${length * 0.58} ${radius * 1.48} ${radius * 0.38}"/></geometry>
        <material name="grip_rubber"/>
      </visual>
      <xacro:if value="${name.endswith('_proximal')}">
        <visual name="${prefix}_${name}_accent">
          <origin xyz="${length * 0.47} 0 ${radius * 0.91}"/>
          <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="${length * 0.27} ${radius * 0.63} ${radius * 0.12}"/></geometry>
          <material name="accent_teal"/>
        </visual>
      </xacro:if>
    </link>
  </xacro:macro>

  <xacro:macro name="finger" params="prefix name x y yaw proximal middle distal radius">
    <joint name="${prefix}_${name}_mcp_joint" type="revolute">
      <parent link="${prefix}_palm"/><child link="${prefix}_${name}_proximal"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 ${yaw}"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.15" effort="2" velocity="3"/>
    </joint>
    <xacro:segment prefix="${prefix}" name="${name}_proximal" length="${proximal}" radius="${radius}"/>

    <joint name="${prefix}_${name}_pip_joint" type="revolute">
      <parent link="${prefix}_${name}_proximal"/><child link="${prefix}_${name}_middle"/>
      <origin xyz="${proximal} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.35" effort="2" velocity="3"/>
    </joint>
    <xacro:segment prefix="${prefix}" name="${name}_middle" length="${middle}" radius="${radius * 0.88}"/>

    <joint name="${prefix}_${name}_dip_joint" type="revolute">
      <parent link="${prefix}_${name}_middle"/><child link="${prefix}_${name}_distal"/>
      <origin xyz="${middle} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.95" effort="2" velocity="3"/>
    </joint>
    <xacro:segment prefix="${prefix}" name="${name}_distal" length="${distal}" radius="${radius * 0.76}"/>
  </xacro:macro>

  <xacro:macro name="thumb" params="prefix x y yaw proximal middle distal radius">
    <joint name="${prefix}_thumb_cmc_joint" type="revolute">
      <parent link="${prefix}_palm"/><child link="${prefix}_thumb_proximal"/>
      <origin xyz="${x} ${y} -0.002" rpy="0 0 ${yaw}"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.75" effort="2" velocity="3"/>
    </joint>
    <xacro:segment prefix="${prefix}" name="thumb_proximal" length="${proximal}" radius="${radius}"/>

    <joint name="${prefix}_thumb_mcp_joint" type="revolute">
      <parent link="${prefix}_thumb_proximal"/><child link="${prefix}_thumb_middle"/>
      <origin xyz="${proximal} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.05" effort="2" velocity="3"/>
    </joint>
    <xacro:segment prefix="${prefix}" name="thumb_middle" length="${middle}" radius="${radius * 0.88}"/>

    <joint name="${prefix}_thumb_ip_joint" type="revolute">
      <parent link="${prefix}_thumb_middle"/><child link="${prefix}_thumb_distal"/>
      <origin xyz="${middle} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.10" effort="2" velocity="3"/>
    </joint>
    <xacro:segment prefix="${prefix}" name="thumb_distal" length="${distal}" radius="${radius * 0.76}"/>
  </xacro:macro>

  <!-- side is +1 for the left hand and -1 for the right hand. -->
  <xacro:macro name="hand" params="prefix side offset_y">
    <link name="${prefix}_palm">
      <visual name="${prefix}_palm_body">
        <geometry><mesh filename="package://hand_motion_rviz/meshes/palm_${prefix}.stl"/></geometry>
        <material name="shell_ivory"/>
      </visual>
      <visual name="${prefix}_palm_knuckle_bar">
        <origin xyz="0.054 0 -0.008"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.018 0.083 0.013"/></geometry>
        <material name="joint_graphite"/>
      </visual>
      <!-- Positive finger flexion bends toward -Z, the palmar surface. -->
      <visual name="${prefix}_palm_pad">
        <origin xyz="0.004 ${side * -0.006} -0.014"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.069 0.061 0.006"/></geometry>
        <material name="grip_rubber"/>
      </visual>
      <visual name="${prefix}_thenar_pad">
        <origin xyz="-0.029 ${side * 0.028} -0.014" rpy="0 0 ${side * 0.37}"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.047 0.027 0.008"/></geometry>
        <material name="grip_rubber"/>
      </visual>
      <visual name="${prefix}_palm_heel">
        <origin xyz="-0.049 ${side * -0.012} -0.014"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.024 0.044 0.006"/></geometry>
        <material name="grip_rubber"/>
      </visual>
      <visual name="${prefix}_palm_accent">
        <origin xyz="0.003 ${side * -0.006} -0.0175"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.036 0.004 0.0015"/></geometry>
        <material name="accent_teal"/>
      </visual>
      <visual name="${prefix}_back_plate">
        <origin xyz="-0.005 0 0.013"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.087 0.067 0.004"/></geometry>
        <material name="joint_graphite"/>
      </visual>
      <visual name="${prefix}_back_accent">
        <origin xyz="-0.006 0 0.0155"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.054 0.006 0.0015"/></geometry>
        <material name="accent_teal"/>
      </visual>
    </link>

    <link name="${prefix}_mount"/>
    <joint name="${prefix}_base_joint" type="fixed">
      <parent link="hands_base"/><child link="${prefix}_mount"/>
      <origin xyz="0 ${offset_y} 0" rpy="0 0 0"/>
    </joint>

    <!-- Rz(yaw) Ry(pitch) Rx(roll): neutral orientation preserves finger axes. -->
    <link name="${prefix}_wrist_yaw"/>
    <joint name="${prefix}_wrist_yaw_joint" type="continuous">
      <parent link="${prefix}_mount"/><child link="${prefix}_wrist_yaw"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="2" velocity="3"/>
    </joint>
    <link name="${prefix}_wrist_pitch"/>
    <joint name="${prefix}_wrist_pitch_joint" type="continuous">
      <parent link="${prefix}_wrist_yaw"/><child link="${prefix}_wrist_pitch"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="2" velocity="3"/>
    </joint>
    <joint name="${prefix}_wrist_roll_joint" type="continuous">
      <parent link="${prefix}_wrist_pitch"/><child link="${prefix}_palm"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit effort="2" velocity="3"/>
    </joint>

    <joint name="${prefix}_palm_to_wrist" type="fixed">
      <parent link="${prefix}_palm"/><child link="${prefix}_wrist"/>
      <origin xyz="-0.082 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}_wrist">
      <visual name="${prefix}_wrist_cuff">
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.045 0.066 0.034"/></geometry>
        <material name="joint_graphite"/>
      </visual>
      <visual name="${prefix}_wrist_trim">
        <origin xyz="-0.011 0 0"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.006 0.068 0.036"/></geometry>
        <material name="shell_ivory"/>
      </visual>
      <visual name="${prefix}_wrist_status">
        <origin xyz="0.008 0 -0.0175"/>
        <geometry><mesh filename="package://hand_motion_rviz/meshes/soft_pad.stl" scale="0.009 0.022 0.002"/></geometry>
        <material name="accent_teal"/>
      </visual>
    </link>

    <xacro:thumb prefix="${prefix}" x="-0.012" y="${side * 0.052}" yaw="${side * 0.72}"
                 proximal="0.034" middle="0.025" distal="0.021" radius="0.0095"/>
    <xacro:finger prefix="${prefix}" name="index" x="0.062" y="${side * 0.032}" yaw="${side * 0.03}"
                  proximal="0.044" middle="0.029" distal="0.023" radius="0.0085"/>
    <xacro:finger prefix="${prefix}" name="middle" x="0.064" y="${side * 0.010}" yaw="0"
                  proximal="0.049" middle="0.032" distal="0.025" radius="0.0088"/>
    <xacro:finger prefix="${prefix}" name="ring" x="0.062" y="${side * -0.014}" yaw="${side * -0.025}"
                  proximal="0.045" middle="0.030" distal="0.023" radius="0.0085"/>
    <xacro:finger prefix="${prefix}" name="little" x="0.057" y="${side * -0.037}" yaw="${side * -0.07}"
                  proximal="0.036" middle="0.024" distal="0.019" radius="0.0075"/>
  </xacro:macro>

  <xacro:hand prefix="left" side="1" offset_y="-0.13"/>
  <xacro:hand prefix="right" side="-1" offset_y="0.13"/>
</robot>
